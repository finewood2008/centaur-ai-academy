---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Contact from '../../components/Contact.astro';
import { publishedEntries, dateLabel } from '../../lib/site';
export async function getStaticPaths() {
  return (await publishedEntries()).map(entry => ({ params: { id: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
---
<Base title={entry.data.title} description={entry.data.summary} article={true} pageClass="article-page">
  <div class="container article-top"><a class="back-link" href="/journal/">← 观点与动态</a></div>
  <article class="article-shell">
    <header class="article-header"><p class="eyebrow">{entry.data.category} / CENTAUR JOURNAL</p><h1>{entry.data.title}</h1><p class="article-summary">{entry.data.summary}</p><div class="article-byline"><span>{entry.data.author}</span><time datetime={entry.data.publishedAt}>{dateLabel(entry.data.publishedAt)}</time></div></header>
    {entry.data.event && <aside class="event-facts" aria-label="活动信息"><span>{entry.data.event.status}</span><dl><div><dt>时间</dt><dd>{entry.data.event.date}</dd></div><div><dt>地点</dt><dd>{entry.data.event.location}</dd></div></dl></aside>}
    {entry.data.cover && <img class="article-cover" src={entry.data.cover} alt={entry.data.coverAlt || ''} width="1448" height="1086" decoding="async" />}
    <div class="prose"><Content /></div>
    <div class="article-end"><span>与 AI 同行，让自己的积累继续生长。</span><a class="text-link" href="/journal/">更多观点与动态 →</a></div>
  </article>
  <Contact compact />
</Base>
