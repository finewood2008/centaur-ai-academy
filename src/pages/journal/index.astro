---
import Base from '../../layouts/Base.astro';
import Contact from '../../components/Contact.astro';
import JournalCard from '../../components/JournalCard.astro';
import { publishedEntries } from '../../lib/site';
const entries = await publishedEntries();
const categories = [{ label: '全部', key: 'all' }, { label: '观点', key: 'ideas' }, { label: '活动', key: 'events' }, { label: '共创记录', key: 'records' }];
---
<Base title="观点与动态" pageClass="journal-page">
  <section class="page-intro container"><p class="eyebrow">CENTAUR JOURNAL / 观点与动态</p><h1>思考，<em>正在发生。</em></h1><p class="intro-description">关于人、AI，和我们一起做的事。</p></section>
  <section class="journal-list-section container">
    <div class="journal-controls"><div class="filter-bar" role="group" aria-label="内容分类">{categories.map(category => <button type="button" data-filter={category.key} data-label={category.label} aria-pressed={category.key === 'all'}>{category.label}</button>)}</div><span class="result-count" role="status" aria-live="polite">{entries.length} 篇内容</span></div>
    <div class="journal-grid journal-list">{entries.map((entry, index) => <JournalCard entry={entry} index={index} />)}</div>
    <div class="journal-empty" hidden={entries.length > 0}><p class="eyebrow">CONTINUE THE CONVERSATION</p><h2 data-empty-title>新的内容，将在这里与你见面。</h2><p data-empty-body>欢迎先与学院聊聊你正在做的事。</p><a class="text-link" href="#contact">联系学院顾问 ↗</a></div>
  </section>
  <Contact compact />
  <script>
    const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-filter]'));
    const cards = Array.from(document.querySelectorAll<HTMLElement>('.journal-list .journal-card'));
    const count = document.querySelector('.result-count');
    const empty = document.querySelector<HTMLElement>('.journal-empty');
    const messages: Record<string, [string, string]> = {
      all: ['新的内容，将在这里与你见面。', '欢迎先与学院聊聊你正在做的事。'],
      ideas: ['把思考写下来，让对话继续。', '学院的新观点文章将在这里发布。'],
      events: ['下一次相聚，从一个真实问题开始。', '新的活动信息将在这里发布。你也可以先与学院顾问聊聊适合自己的参与方式。'],
      records: ['把过程留下，让经验继续生长。', '我们将在获得参与者同意后，分享真实的尝试、调整与成果。'],
    };
    function applyFilter(key: string) {
      const selected = buttons.find(button => button.dataset.filter === key) || buttons[0];
      key = selected.dataset.filter!;
      buttons.forEach(button => button.setAttribute('aria-pressed', String(button === selected)));
      cards.forEach(card => { card.hidden = key !== 'all' && card.dataset.category !== selected.dataset.label; });
      const visible = cards.filter(card => !card.hidden).length;
      if (count) count.textContent = `${visible} 篇内容`;
      if (empty) {
        empty.hidden = visible > 0;
        empty.querySelector('[data-empty-title]')!.textContent = messages[key][0];
        empty.querySelector('[data-empty-body]')!.textContent = messages[key][1];
      }
    }
    buttons.forEach(button => button.addEventListener('click', () => {
      const key = button.dataset.filter!;
      history.replaceState(null, '', key === 'all' ? location.pathname : `#${key}`);
      applyFilter(key);
    }));
    window.addEventListener('hashchange', () => applyFilter(location.hash.slice(1) || 'all'));
    applyFilter(location.hash.slice(1) || 'all');
  </script>
</Base>
