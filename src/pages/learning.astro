---
import Base from '../layouts/Base.astro';
import Contact from '../components/Contact.astro';
import LearningProcess from '../components/LearningProcess.astro';
const formats = [
  { number: '01', title: '主题分享', caption: '一起讨论人的位置', body: '讨论人机共生、判断与个人积累，再把主张带进实际工作。' },
  { number: '02', title: '动手实践', caption: '让想法有一个初版', body: '带着自己的材料，整理知识、构建应用，再亲手试用。' },
  { number: '03', title: '同伴交流', caption: '看见不同的经验', body: '分享方法与困难，让不同的行业经验参与思考。' },
  { number: '04', title: '日常答疑', caption: '把卡住的地方讲清楚', body: '说清目标、尝试与卡住的地方，一起找到下一步。' },
];
---
<Base title="共学共创" pageClass="learning-page">
  <section class="page-intro container"><p class="eyebrow">LEARN & CREATE / 共学共创</p><h1>带着真实问题，<br /><em>一起学，一起做。</em></h1><p class="intro-description">把新的方法，带进每天的工作。</p></section>
  <figure class="container learning-panorama" data-reveal><img src="/assets/co-learning.png" width="1448" height="1086" alt="概念插画：同伴围桌分享与讨论" fetchpriority="high" /><figcaption><span>LEARNING IS A SHARED JOURNEY</span><span>主题分享 · 动手实践 · 同伴交流 · 日常答疑</span></figcaption></figure>
  <section class="section border-top"><div class="container"><div class="section-heading"><div><p class="eyebrow">我们怎样一起学习</p><h2>分享、尝试、交流，<br />都从你的需要出发。</h2></div><p class="heading-aside">学院面向长期参与的会员关系，<br />围绕共学与共创建立持续连接。</p></div><div class="format-grid">{formats.map(format => <article class="format-item"><span class="step-number">{format.number}</span><h3>{format.title}</h3><p class="format-caption">{format.caption}</p><p>{format.body}</p></article>)}</div></div></section>
  <section class="section learning-section"><div class="container"><p class="eyebrow">从问题到下一次行动</p><h2>把学习，走成一个过程。</h2><LearningProcess /></div></section>
  <section class="section"><div class="container split-section"><div><p class="eyebrow">你可以带什么来</p><h2>一件想做的事，<br />就是很好的开始。</h2></div><div class="question-list"><div><span>关于资料</span><p>散落在文件里的经验，怎样在下一次工作中用起来？</p></div><div><span>关于工作</span><p>每天反复处理的一件小事，能不能变成自己的工具？</p></div><div><span>关于判断</span><p>面对不同方案，怎样让 AI 帮我看得更全面？</p></div></div></div></section>
  <section class="section join-note"><div class="container split-section"><div><p class="eyebrow">关于长期参与</p><h2>先认识彼此，<br />再找到适合的参与方式。</h2></div><div class="section-body"><p>与愿意持续学习的经营者与管理者同行。先聊聊你正在做的事，以及期待获得的支持。</p><p>会员权益、活动安排与费用，待方案明确后补充。</p><a class="text-link" href="/journal/#events">关注活动信息 ↗</a></div></div></section>
  <Contact />
</Base>
